pipeline {
    agent any

    options {
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        MY_SERVICE = 'discount-service'
    }

    stages {
        stage('Workspace Clean') {
            steps {
                cleanWs()
            }
        }

        stage('Git Checkout') {
            steps {
                git branch: "${env.BRANCH_NAME}", url: 'https://github.com/Praveen230389/Ecommerce-Project.git'
                script {
                    env.ACTUAL_BRANCH = env.BRANCH_NAME
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials-id',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    script {
                        sh 'docker system prune -f'
                        sh '''
                            ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                            LOCAL_ECR_URL="${ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"
                            FULL_IMAGE_TAG="${LOCAL_ECR_URL}/${MY_SERVICE}:${ACTUAL_BRANCH}-${BUILD_NUMBER}"

                            echo "Building image for ${MY_SERVICE}..."
                            docker build -t Ecommerse/${MY_SERVICE} \
                                -t ${FULL_IMAGE_TAG} \
                                -f ${MY_SERVICE}/Dockerfile \
                                ${MY_SERVICE}/
                        '''
                    }
                }
            }
        }

        stage('AWS ECR Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials-id',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    echo 'Logging into Amazon ECR Registry...'
                    sh """
                        ACCOUNT_ID=\$(aws sts get-caller-identity --query Account --output text)

                        aws ecr get-login-password \
                            --region ${env.AWS_DEFAULT_REGION} \
                            | docker login \
                                --username AWS \
                                --password-stdin \
                                \${ACCOUNT_ID}.dkr.ecr.${env.AWS_DEFAULT_REGION}.amazonaws.com
                    """
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                script {
                    sh "docker save Ecommerse/${env.MY_SERVICE} -o service.tar"
                    sh "trivy image --input service.tar --scanners vuln --offline-scan > trivyresults.txt || true"
                    sh 'rm -f service.tar'
                }
            }
        }

        stage('Docker Push Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials-id',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                        LOCAL_ECR_URL="${ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        echo "Pushing ${MY_SERVICE} to ECR..."
                        docker push ${LOCAL_ECR_URL}/${MY_SERVICE}:${ACTUAL_BRANCH}-${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Load AWS Credentials') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials-id',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        echo "=============================================="
                        echo "Loading AWS Credentials"
                        echo "=============================================="
                        aws sts get-caller-identity
                    '''
                }
            }
        }

        stage('Generate Kubeconfig') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials-id',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        export KUBECONFIG="${WORKSPACE}/.kube-config"
                        aws eks update-kubeconfig \
                            --region ap-south-1 \
                            --name ecommerce-cluster \
                            --kubeconfig "${KUBECONFIG}"
                    '''
                }
            }
        }

        stage('Verify Cluster Connectivity') {
            steps {
                sh '''
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    echo "=============================================="
                    echo "Cluster Information"
                    echo "=============================================="
                    kubectl cluster-info
                    kubectl version --short || true
                '''
            }
        }

        stage('Verify Worker Nodes') {
            steps {
                sh '''
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    echo "=============================================="
                    echo "Worker Nodes"
                    echo "=============================================="
                    kubectl get nodes -o wide
                '''
            }
        }

        stage('Verify Namespaces') {
            steps {
                sh '''
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    echo "=============================================="
                    echo "Namespaces"
                    echo "=============================================="
                    kubectl get ns
                '''
            }
        }

        stage('Prepare Environment Variables') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials-id',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        set -e
                        pwd
                        ls -la

                        ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                        echo "ACCOUNT_ID=${ACCOUNT_ID}" > "${WORKSPACE}/deploy.env"
                        echo "ECR=${ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com" >> "${WORKSPACE}/deploy.env"

                        if [ "${ACTUAL_BRANCH}" = "main" ]; then
                            NAMESPACE="production"
                        elif [ "${ACTUAL_BRANCH}" = "develop" ]; then
                            NAMESPACE="dev"
                        elif [ "${ACTUAL_BRANCH}" = "testing" ]; then
                            NAMESPACE="testing"
                        else
                            echo "Unknown Branch : ${ACTUAL_BRANCH}"
                            exit 1
                        fi

                        echo "NAMESPACE=${NAMESPACE}" >> "${WORKSPACE}/deploy.env"
                        echo "===== deploy.env ====="
                        cat "${WORKSPACE}/deploy.env"
                    '''
                }
            }
        }

        stage('Create Production Namespace') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl create namespace "${NAMESPACE}" \
                        --dry-run=client -o yaml | kubectl apply -f -
                '''
            }
        }

        stage('Update & Apply Global Core Infrastructure') {
            steps {
                sh '''
                    set -e
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a

                    if kubectl get ingress -n "${NAMESPACE}" --kubeconfig "${KUBECONFIG}" >/dev/null 2>&1; then
                        echo "Global Infrastructure already exists."
                    else
                        echo "Applying Global Infrastructure..."
                        if [ -d "./k8s" ]; then
                            find ./k8s -name "*.yaml" ! -name "namespaces.yaml" -exec sed -i "s|REPLACE_WITH_AWS_ECR_URL|${ECR}|g" {} +
                            find ./k8s -name "*.yaml" ! -name "namespaces.yaml" -exec sed -i "s|:latest|:${ACTUAL_BRANCH}-${BUILD_NUMBER}|g" {} +
                            kubectl apply -f ./k8s -n "${NAMESPACE}" --kubeconfig "${KUBECONFIG}"
                        else
                            echo "k8s folder not found"
                            exit 1
                        fi
                    fi
                '''
            }
        }

        stage('Update Service Manifest') {
            steps {
                sh '''
                    set -e
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a

                    if [ -d "./${MY_SERVICE}/k8s" ]; then
                        echo "Updating ${MY_SERVICE} manifests..."
                        find ./${MY_SERVICE}/k8s -name "*.yaml" \
                            -exec sed -i "s|\\${NAMESPACE}|${NAMESPACE}|g" {} +
                        find ./${MY_SERVICE}/k8s -name "*.yaml" \
                            -exec sed -i "s|\\${SERVICE_NAME}|${MY_SERVICE}|g" {} +
                        find ./${MY_SERVICE}/k8s -name "*.yaml" \
                            -exec sed -i "s|\\${ECR_REGISTRY}|${ECR}|g" {} +
                        find ./${MY_SERVICE}/k8s -name "*.yaml" \
                            -exec sed -i "s|\\${IMAGE_TAG}|${ACTUAL_BRANCH}-${BUILD_NUMBER}|g" {} +
                    fi
                '''
            }
        }

        stage('Deploy Service to EKS') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    if [ -d "./${MY_SERVICE}/k8s" ]; then
                        kubectl apply -f ./${MY_SERVICE}/k8s -n ${NAMESPACE}
                    fi
                '''
            }
        }

        stage('Verify Deployments') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl get deployment -n ${NAMESPACE}
                '''
            }
        }

        stage('Verify ReplicaSets') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl get rs -n ${NAMESPACE}
                '''
            }
        }

        stage('Verify Pods') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl get pods -n ${NAMESPACE} -o wide
                '''
            }
        }

        stage('Describe Pending Pods') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl get pods -n ${NAMESPACE} \
                        --field-selector=status.phase=Pending \
                        -o name | while read pod
                    do
                        echo "====================================="
                        echo "$pod"
                        echo "====================================="
                        kubectl describe $pod -n ${NAMESPACE} || true
                    done
                '''
            }
        }

        stage('Verify Services') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl get svc -n ${NAMESPACE}
                '''
            }
        }

        stage('Verify Endpoints') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl get endpoints -n ${NAMESPACE}
                '''
            }
        }

        stage('Verify Ingress') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl get ingress -n ${NAMESPACE}
                    kubectl describe ingress -n ${NAMESPACE} || true
                '''
            }
        }

        stage('Verify Events') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl get events \
                        -n ${NAMESPACE} \
                        --sort-by=.metadata.creationTimestamp | tail -100 || true
                '''
            }
        }

        stage('Rollout Status') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    kubectl rollout status deployment/${MY_SERVICE} \
                        -n "${NAMESPACE}" \
                        --timeout=60s || true
                '''
            }
        }

        stage('Final Cluster Summary') {
            steps {
                sh '''
                    set -a
                    . "${WORKSPACE}/deploy.env"
                    set +a
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    echo "==========================================="
                    echo "FINAL DEPLOYMENT STATUS"
                    echo "==========================================="
                    kubectl get nodes
                    echo ""
                    kubectl get deployment -n ${NAMESPACE}
                    echo ""
                    kubectl get pods -n ${NAMESPACE} -o wide
                    echo ""
                    kubectl get svc -n ${NAMESPACE}
                    echo ""
                    kubectl get ingress -n ${NAMESPACE}
                '''
            }
        }
    }

    post {
        always {
            script {
                echo 'Cleaning up local workspace cache...'
                sh 'docker image prune -f || true'
                cleanWs()
            }
        }
    }
}
