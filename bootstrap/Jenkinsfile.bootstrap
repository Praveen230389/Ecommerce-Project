pipeline {
    agent any
    
    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }
    
    environment {
        AWS_DEFAULT_REGION = "ap-south-1"
        
        // 🔐 क्लस्टर एडमिन क्रेडेंशियल्स
        AWS_CREDENTIALS = credentials('aws-credentials-id')
        AWS_ACCESS_KEY_ID = "${env.AWS_CREDENTIALS_USR}"
        AWS_SECRET_ACCESS_KEY = "${env.AWS_CREDENTIALS_PSW}"
    }
    
    stages {
        stage('Clean Workspace & Checkout Core') {
            steps {
                cleanWs()
                checkout scm
            }
        }
        
        stage('Generate EKS Kubeconfig') {
            steps {
                sh '''
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    aws eks update-kubeconfig \
                        --region ${AWS_DEFAULT_REGION} \
                        --name ecommerce-cluster \
                        --kubeconfig "${KUBECONFIG}"
                '''
            }
        }
        
        stage('Create Base Namespaces') {
            steps {
                sh '''
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    echo "🚀 Creating core namespaces (dev, testing, production)..."
                    if [ -f "./k8s/namespaces.yaml" ]; then
                        kubectl apply -f ./k8s/namespaces.yaml --kubeconfig "${KUBECONFIG}"
                    else
                        kubectl create namespace production --dry-run=client -o yaml | kubectl apply -f - --kubeconfig "${KUBECONFIG}"
                        kubectl create namespace dev --dry-run=client -o yaml | kubectl apply -f - --kubeconfig "${KUBECONFIG}"
                    fi
                '''
            }
        }
        
        stage('Deploy AWS ALB Ingress Controller') {
            steps {
                sh '''
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    echo "🌐 Deploying Global Application Load Balancer Manifests..."
                    
                    # रूट के मुख्य k8s फोल्डर से केवल ingress और नेटवर्क मैनिफेस्ट्स को चलाना
                    if [ -f "./k8s/ingress.yaml" ]; then
                        kubectl apply -f ./k8s/ingress.yaml -n production --kubeconfig "${KUBECONFIG}"
                        echo "✅ Core ALB Ingress deployed successfully!"
                    else
                        echo "⚠️ Warning: ingress.yaml not found in root k8s/ folder."
                    fi
                '''
            }
        }
        
        stage('Verify Bootstrap Status') {
            steps {
                sh '''
                    export KUBECONFIG="${WORKSPACE}/.kube-config"
                    echo "📊 Core Platform Bootstrap Summary:"
                    kubectl get ns --kubeconfig "${KUBECONFIG}"
                    kubectl get ingress -A --kubeconfig "${KUBECONFIG}"
                '''
            }
        }
    }
}
