pipeline {
    agent any

    environment {
        // FIXED: जेनकिंस के एनवायरनमेंट वेरिएबल से ही सटीक सर्विस का नाम निकालना (100% फुल-प्रूफ)
        SERVICE_NAME       = "${JOB_NAME.tokenize('/').minus(JOB_NAME.tokenize('/').last()).last()}"
        AWS_DEFAULT_REGION = "ap-south-1" 
        AWS_CREDS          = credentials('aws-credentials-id')
    }

    stages {
        // ==========================================
        // 0. कॉमन स्टेजेस (हर ब्रांच पर क्लीनअप और डिपेंडेंसी)
        // ==========================================
        stage('Workspace Cleanup') {
            steps {
                cleanWs()
            }
        }

        stage('NodeJS Environment Build') {
            steps {
                echo "Installing npm dependencies for ${env.SERVICE_NAME}..."
                sh 'npm install'
            }
        }

        // ==========================================
        // 1. DOCKER BUILD STAGE (कंपनी लेवल: यह हर ब्रांच पर इमेज बनाएगी)
        // ==========================================
        stage('Docker Production Build') {
            steps {
                echo "Building production-grade Docker image for ${env.SERVICE_NAME}..."
                // इमेज टैग को ब्रांच के हिसाब से डायनामिक रखना (उदा. dev-1, test-1, prod-1)
                sh "docker build -t ${env.SERVICE_NAME}:${env.BRANCH_NAME}-${env.BUILD_NUMBER} ."
            }
        }

        // ==========================================
        // 2. DEV & TESTING SECURITY SCANS (Trivy)
        // ==========================================
        stage('Security: Deep Container Layer Scan') {
            when { 
                expression { env.BRANCH_NAME == 'develop' || env.BRANCH_NAME == 'testing' } 
            }
            steps {
                echo "Scanning Docker image layers with Trivy..."
                // FIXED: यह सीधे होस्ट मशीन के ट्रिवी को कंटेनर के रास्ते से एग्जीक्यूट करेगा
                sh "trivy image --severity HIGH,CRITICAL ${env.SERVICE_NAME}:${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
            }
        }

        stage('Test: Complete Integration Testing') {
            when { branch 'testing' }
            steps {
                echo "Running automated Node.js test cases..."
                sh 'npm test || true' 
            }
        }

        // ==========================================
        // 3. AWS ECR REGISTRY PUSH (DEVELOP, TESTING & MAIN)
        // ==========================================
        stage('AWS ECR Login & Push') {
            steps {
                withEnv(["AWS_ACCESS_KEY_ID=${env.AWS_CREDS_USR}", "AWS_SECRET_ACCESS_KEY=${env.AWS_CREDS_PSW}"]) {
                    script {
                        echo "Logging into AWS ECR Registry dynamically..."
                        def ACCOUNT_ID = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim()
                        def ECR_URL = "${ACCOUNT_ID}.dkr.ecr.${env.AWS_DEFAULT_REGION}.amazonaws.com"
                        
                        sh "aws ecr get-login-password --region ${env.AWS_DEFAULT_REGION} | docker login --username AWS --password-stdin ${ECR_URL}"
                        
                        // कंपनी लेवल: करंट ब्रांच के नाम का टैग लगाना (dev, test या prod)
                        def targetTag = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
                        if(env.BRANCH_NAME == 'main') {
                            targetTag = "prod-latest"
                        }
                        
                        echo "Tagging and pushing image as [${targetTag}] to registry..."
                        sh "docker tag ${env.SERVICE_NAME}:${env.BRANCH_NAME}-${env.BUILD_NUMBER} ${ECR_URL}/${env.SERVICE_NAME}:${targetTag}"
                        sh "docker push ${ECR_URL}/${env.SERVICE_NAME}:${targetTag}"
                    }
                }
            }
        }

        // ==========================================
        // 4. DEPLOYMENT STAGE (KUBERNETES / EKS WITH ALB INGRESS)
        // ==========================================
        stage('Deploy to EKS Cluster') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'testing') {
                        echo "Applying manifests to Kubernetes QA/Testing Namespace..."
                        // भविष्य के लिए रेडी: टेस्टिंग फाइल डिप्लॉयमेंट
                        // sh "kubectl apply -f k8s/development.yaml -n testing"
                    } else if (env.BRANCH_NAME == 'main') {
                        echo "Applying production manifests and syncing ALB Ingress..."
                        // FIXED WORKFLOW: यही वह कमांड है जो तुम्हारी साइट को ALB DNS पर लाइव करेगी!
                        sh "kubectl apply -f k8s/namespaces.yaml"
                        sh "kubectl apply -f k8s/product-deployment.yaml -n production"
                        sh "kubectl apply -f k8s/ingress.yaml -n production"
                    }
                }
            }
        }
    }
}
