pipeline {
    agent any

    environment {
        // --- 1. AUTOMATIC SERVICE DETECTION (No manual edits needed!) ---
        // यह कमांड अपने आप उस फोल्डर का नाम निकाल लेगी जिसके अंदर यह जेनकिंसफाइल चल रही है
        SERVICE_NAME       = "${sh(script: 'basename \$(pwd)', returnStdout: true).trim()}"
        AWS_DEFAULT_REGION = "ap-south-1" 
        
        // --- 2. AWS CREDENTIALS ID FROM JENKINS UI ---
        // तुम्हें बस जेनकिंस के क्रेडेंशियल मैनेजर में एक बार 'aws-credentials-id' नाम से अपनी चाबियां (Keys) सेव करनी हैं
        AWS_CREDS          = credentials('aws-credentials-id')
    }

    stages {
        // ==========================================
        // 0. कॉमन स्टेजेस (ये हर ब्रांच पर चलेंगी)
        // ==========================================
        stage('Workspace Cleanup') {
            steps {
                cleanWs()
            }
        }

        stage('NodeJS Environment Build') {
            steps {
                echo "Installing npm dependencies for ${env.SERVICE_NAME}..."
                sh 'npm install'
            }
        }

        // ==========================================
        // 1. DEVELOP BRANCH STAGES (फास्ट और लाइटवेट सुरक्षा जांच)
        // ==========================================
        stage('Dev: Fast Vulnerability Check') {
            when { branch 'develop' } 
            steps {
                echo "Running quick Trivy File System scan for developers..."
                sh "trivy fs --severity HIGH,CRITICAL --format table ."
            }
        }

        stage('Dev: Build Local Container Image') {
            when { branch 'develop' }
            steps {
                echo "Building local temporary development image..."
                sh "docker build -t ${env.SERVICE_NAME}:dev-${env.BUILD_NUMBER} ."
            }
        }

        stage('Test: Full Dependency Scan (SCA)') {
            when { branch 'testing' }
            steps {
                echo "Running complete Software Composition Analysis..."
                sh "trivy fs --format table -o testing-full-report.html ."
            }
        }

        stage('Test: Complete Integration Testing') {
            when { branch 'testing' }
            steps {
                echo "Running automated Node.js test cases..."
                sh 'npm test || true' 
            }
        }

        stage('Test: Docker Production Build') {
            when { branch 'testing' }
            steps {
                echo "Building production-grade Docker image using multi-stage Dockerfile..."
                sh "docker build -t ${env.SERVICE_NAME}:${env.BUILD_NUMBER} ."
            }
        }

        stage('Test: Deep Container Layer Scan') {
            when { branch 'testing' }
            steps {
                echo "Scanning final Docker image layers with Trivy..."
                sh "trivy image --severity HIGH,CRITICAL ${env.SERVICE_NAME}:${env.BUILD_NUMBER}"
            }
        }

        stage('Test: AWS ECR Login & Push') {
            when { branch 'testing' }
            steps {
                echo "Logging into AWS ECR Registry dynamically..."
                withEnv(["AWS_ACCESS_KEY_ID=${env.AWS_CREDS_USR}", "AWS_SECRET_ACCESS_KEY=${env.AWS_CREDS_PSW}"]) {
                    script {
                        // ऑटोमेटिक अकाउंट आईडी डिटेक्शन (तुम्हारी output.tf से मेल खाता हुआ)
                        def ACCOUNT_ID = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim()
                        def ECR_URL = "${ACCOUNT_ID}.dkr.ecr.${env.AWS_DEFAULT_REGION}.amazonaws.com"
                        
                        sh "aws ecr get-login-password --region ${env.AWS_DEFAULT_REGION} | docker login --username AWS --password-stdin ${ECR_URL}"
                        
                        echo "Tagging and pushing testing image to registry..."
                        sh "docker tag ${env.SERVICE_NAME}:${env.BUILD_NUMBER} ${ECR_URL}/${env.SERVICE_NAME}:test-${env.BUILD_NUMBER}"
                        sh "docker push ${ECR_URL}/${env.SERVICE_NAME}:test-${env.BUILD_NUMBER}"
                    }
                }
            }
        }

        stage('Test: Deploy to Kubernetes QA Namespace') {
            when { branch 'testing' }
            steps {
                echo "Applying manifests (development.yaml) to Kubernetes QA Cluster..."
                // थ्योरी/कनेक्शन: जब कूबरनेटीस लाइव होगा तो ये कमांड्स एक्टिवेट कर दी जाएंगी
                // sh "kubectl apply -f development.yaml"
            }
        }

        // ==========================================
        // 3. PRODUCTION / MAIN BRANCH STAGES (सिर्फ डिप्लॉयमेंट)
        // ==========================================
        stage('Prod: Push Production Release Image') {
            when { branch 'main' } 
            steps {
                echo "Tagging and pushing final production release image to AWS ECR..."
                withEnv(["AWS_ACCESS_KEY_ID=${env.AWS_CREDS_USR}", "AWS_SECRET_ACCESS_KEY=${env.AWS_CREDS_PSW}"]) {
                    script {
                        def ACCOUNT_ID = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim()
                        def ECR_URL = "${ACCOUNT_ID}.dkr.ecr.${env.AWS_DEFAULT_REGION}.amazonaws.com"
                        
                        sh "docker tag ${env.SERVICE_NAME}:${env.BUILD_NUMBER} ${ECR_URL}/${env.SERVICE_NAME}:prod-latest"
                        sh "docker push ${ECR_URL}/${env.SERVICE_NAME}:prod-latest"
                    }
                }
            }
        }

        stage('Prod: GitOps ArgoCD Synchronization Trigger') {
            when { branch 'main' }
            steps {
                echo "Updating GitOps manifest file inside infrastructure repository..."
                echo "ArgoCD will automatically sync the production EKS cluster with AWS ALB Ingress."
            }
        }
    }
}
