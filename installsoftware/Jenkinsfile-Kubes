pipeline {
    agent any

    options {
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        AWS_DEFAULT_REGION = "ap-south-1"
    }

    stages {

        stage('EKS kubeconfig') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials-id',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        sudo -E -u jenkins mkdir -p /var/lib/jenkins/.kube

                        sudo -E -u jenkins aws eks update-kubeconfig \
                            --region ${AWS_DEFAULT_REGION} \
                            --name ecommerce-cluster

                        sudo -E -u jenkins kubectl config current-context
                        sudo -E -u jenkins kubectl get nodes
                    '''
                }
            }
        }

        stage('AWS Load Balancer Controller Install') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials-id',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        sudo -E -u jenkins helm upgrade --install aws-load-balancer-controller \
                            eks/aws-load-balancer-controller \
                            -n kube-system \
                            --create-namespace \
                            --set clusterName=ecommerce-cluster

                        sudo -E -u jenkins kubectl rollout status deployment/aws-load-balancer-controller \
                            -n kube-system

                        sudo -E -u jenkins kubectl get pods -n kube-system
                    '''
                }
            }
        }

        stage('Wait for ALB') {
            steps {
                sh '''
                    echo "Waiting for ALB..."

                    sudo -u jenkins kubectl wait \
                        --for=jsonpath='{.status.loadBalancer.ingress[0].hostname}' \
                        ingress/ecommerce-alb-ingress \
                        -n production \
                        --timeout=300s

                    ALB=$(sudo -u jenkins kubectl get ingress ecommerce-alb-ingress \
                        -n production \
                        -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')

                    echo "ALB DNS = http://$ALB"
                '''
            }
        }
    }
}
